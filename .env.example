# Plantilla de variables de entorno. Copia a .env y rellena.
# El .env real está en .gitignore y nunca se commitea.

# --- Claude (obligatorio) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Backends de producción (opcionales) ---
# Sin estas variables, el sistema corre todo en memoria (desarrollo).
# Tras `docker compose up -d`, descomenta para usar los backends reales:
# REDIS_URL=redis://localhost:6379
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=kaizen-neo4j
# DATABASE_URL=postgresql://kaizen:kaizen@localhost:5432/kaizen

# --- Envío de correo (opcional, para el Agente de Redacción) ---
# SMTP_HOST=smtp.tuproveedor.com
# SMTP_USER=tu@correo.com
# SMTP_PASS=...

# --- Panel ---
# SOE_SIM=1   # arranca el panel en modo simulación (sin red ni coste)
# KAIZEN_TOKEN=pon-aqui-un-token-secreto   # si se define, el panel exige este token (auth)
# KAIZEN_USE_PIPELINES=1
# Activa sub-agentes con routing de modelos. Cada departamento usa el modelo más barato
# adecuado para cada tipo de tarea. En False (defecto): comportamiento legacy.
# KAIZEN_TEST_LLM=1
# Permite que los tests de integración hagan llamadas LLM REALES (con coste). Sin definir,
# esos tests se saltan, así `pytest` no gasta API.

# --- Seguridad y guardarraíles (auditoría 2026-06-07) ---
# KAIZEN_TOKEN=token-secreto            # OBLIGATORIO en modo real: sin él, los endpoints quedan bloqueados
# KAIZEN_ALLOW_NO_TOKEN=1               # opt-in consciente para panel abierto en local (NO en producción)
# KAIZEN_AUTO_APPROVE=1                 # auto-aprueba acciones de criticidad alta (NO en producción)
# KAIZEN_VOICE_SIG_BYPASS=false         # el bypass de firma de webhooks SOLO opera en SOE_SIM/tests
# KAIZEN_VOZ_MAX_LLAMADAS_DIA=25        # límite duro de llamadas salientes/día (anti-bucle)
# KAIZEN_TELEFONO_CONTACTO=900 000 000  # teléfono de devolución dictado en mensajes de voz
# KAIZEN_COMPANY=laboratorio                # empresa por defecto del panel/CLI (multi-tenant)
# KAIZEN_ALLOW_MEMORY_FALLBACK=1        # permite degradar Knowledge a memoria si el disco falla (pierde datos)
# KAIZEN_MODEL_COMPROMISOS=claude-sonnet-4-6   # modelo del detector de compromisos
# OPENROUTER_REFERER=https://tudominio.com     # referer enviado a OpenRouter
# TWILIO_FROM_NUMBER: debe ser FIJO español (+34 8xx/9xx) o 800/900 — la Orden TDF/149/2025
# prohíbe numeración móvil como origen de llamadas comerciales. El pre-flight lo bloquea.
